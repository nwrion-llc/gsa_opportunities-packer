[Unit]
Description=Fetch runtime config and prepare the gsa_opportunities app (roles/db/migrations)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Before=gunicorn.service celery-worker.service celery-beat.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/opt/app/bin/bootstrap.sh
# Fast first-line recovery for transient failures (a network blip, a
# momentary Secret Manager error) - persistent failures (e.g. a bad branch
# name) are instead caught by app-deploy-check.timer, which keeps retrying
# indefinitely every 5 minutes regardless of this giving up.
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
