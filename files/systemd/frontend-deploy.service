[Unit]
Description=Clone and build gsa_opportunities_frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/opt/frontend/bin/frontend-deploy.sh
# Fast first-line recovery for transient failures - persistent failures are
# instead caught by frontend-deploy-check.timer, which keeps retrying
# indefinitely every 5 minutes regardless of this giving up.
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
